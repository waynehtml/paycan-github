{
  "id": "http_request_download_oauth_multiple_reports",
  "handler": "oedis.handler.http.request",
  "params": {
    "connection": {
      "base_url": "https://api.vendor.example.com/v1",
      "timeout_sec": 120,
      "auth": {
        "type": "oauth2_client_credentials",
        "token_url": "https://auth.vendor.example.com/token",
        "client_id": "{{ keyvault(scope=\"dis-secrets\", key=\"http-client-id\") }}",
        "client_secret": "{{ keyvault(scope=\"dis-secrets\", key=\"http-client-secret\") }}",
        "client_auth_method": "body",
        "scope": "reports.read",
        "token_headers": {
          "Accept": "application/json"
        }
      }
    },
    "requests": [
      {
        "id": "download_metadata",
        "method": "GET",
        "path": "reports/daily/metadata",
        "headers": {
          "Accept": "application/json"
        },
        "params": {
          "date": "{{ runtime.rundate }}"
        },
        "response": {
          "expected_status": 200,
          "save_to": "raw/oauth-metadata_{{ runtime.rundate }}.json"
        }
      },
      {
        "id": "download_data",
        "method": "GET",
        "path": "reports/daily/data",
        "headers": {
          "Accept": "text/csv"
        },
        "params": {
          "date": "{{ runtime.rundate }}"
        },
        "response": {
          "expected_status": 200,
          "save_to": "raw/oauth-data_{{ runtime.rundate }}.csv"
        }
      }
    ]
  }
}
