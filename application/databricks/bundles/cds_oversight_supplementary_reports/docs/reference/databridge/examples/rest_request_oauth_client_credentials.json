{
  "id": "request",
  "handler": "oedis.handler.rest.request",
  "params": {
    "connection": {
      "timeout_sec": 60,
      "headers": {
        "Accept": "application/json",
        "Content-Type": "application/json"
      },
      "auth": {
        "type": "oauth2_client_credentials",
        "token_url": "https://login.example.com/oauth2/token",
        "client_id": "{{ keyvault(scope=\"dis-secrets\", key=\"client_id\") }}",
        "client_secret": "{{ keyvault(scope=\"dis-secrets\", key=\"client_secret\") }}",
        "scope": "api.read"
      }
    },
    "requests": [
      {
        "id": "series_info",
        "method": "POST",
        "url": "https://example/api/series/info",
        "headers": {
          "X-Request-Id": "{{ rundate }}-{{ param(name=\"vectorId\") }}"
        },
        "body": {
          "type": "json",
          "value": [
            {
              "vectorId": "{{ param(name=\"vectorId\") }}"
            }
          ]
        },
        "file": "raw/series_info_{{ rundate }}.json"
      }
    ]
  }
}
