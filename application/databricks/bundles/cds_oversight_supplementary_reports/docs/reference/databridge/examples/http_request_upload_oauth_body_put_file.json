{
  "id": "http_request_oauth_body_file",
  "handler": "oedis.handler.http.request",
  "params": {
    "connection": {
      "base_url": "https://api.vendor.example.com/v1",
      "timeout_sec": 60,
      "headers": {
        "Accept": "application/json"
      },
      "auth": {
        "type": "oauth2_client_credentials",
        "token_url": "https://auth.vendor.example.com/token",
        "client_id": "{{ keyvault(scope=\"dis-secrets\", key=\"http-client-id\") }}",
        "client_secret": "{{ keyvault(scope=\"dis-secrets\", key=\"http-client-secret\") }}",
        "client_auth_method": "body",
        "scope": "reports.write",
        "token_params": {
          "audience": "https://api.vendor.example.com"
        }
      }
    },
    "requests": [
      {
        "id": "upload_archive",
        "method": "PUT",
        "path": "archives/daily",
        "body": {
          "type": "file",
          "path": "prepared/report.zip",
          "content_type": "application/zip"
        },
        "response": {
          "expected_status": [
            200,
            201
          ],
          "save_to": "receipts/oauth-body-upload.json"
        }
      }
    ]
  }
}
