{
  "id": "compress",
  "handler": "oedis.handler.archive.compress",
  "params": {
    "credential": {
      "passphrase": "{{keyvault(scope='dept-kv', key='archive_pass')}}"
    },
    "requests": [
      {
        "src_dir": "unit_data/out",
        "include": "*.csv",
        "exclude": "tmp/*_tmp.csv",
        "format": "7z",
        "dst_dir": "unit_data/archives",
        "delete_source_file": false,
        "recursive": true
      }
    ]
  }
}
