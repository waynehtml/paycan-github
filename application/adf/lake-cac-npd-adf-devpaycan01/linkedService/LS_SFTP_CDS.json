{
	"name": "LS_SFTP_CDS",
	"properties": {
		"parameters": {
			"host": {
				"type": "string"
			},
			"user_name": {
				"type": "string"
			},
			"secret_name": {
				"type": "string"
			},
			"port": {
				"type": "int",
				"defaultValue": 22
			}
		},
		"annotations": [],
		"type": "Sftp",
		"typeProperties": {
			"host": "@{linkedService().host}",
			"port": "@linkedService().port",
			"skipHostKeyValidation": true,
			"authenticationType": "SshPublicKey",
			"userName": "@{linkedService().user_name}",
			"privateKeyContent": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "LS_Keyvault",
					"type": "LinkedServiceReference"
				},
				"secretName": {
					"value": "@linkedService().secret_name",
					"type": "Expression"
				}
			}
		},
		"connectVia": {
			"referenceName": "IR-SelfHost01",
			"type": "IntegrationRuntimeReference"
		}
	}
}