{
	"name": "_Test_DS_Google_Binary_File_Connection_Acss",
	"properties": {
		"description": "Test connectivity to dataset",
		"activities": [
			{
				"name": "Get Metadata",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "Get Access Id",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_Google_Binary_File",
						"type": "DatasetReference",
						"parameters": {
							"access_id": {
								"value": "@activity('Get Access Id').output.value",
								"type": "Expression"
							},
							"container": "acs-test-general-boc-acss-bucket",
							"directory": "daily",
							"filename": "@null"
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "GoogleCloudStorageReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "Get Access Id",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": true,
					"secureInput": true
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": {
						"value": "@pipeline().globalParameters.gpm_keyvault_url",
						"type": "Expression"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			}
		],
		"variables": {
			"gcp_access_id": {
				"type": "String"
			}
		},
		"folder": {
			"name": "ACSS/Tests"
		},
		"annotations": []
	}
}