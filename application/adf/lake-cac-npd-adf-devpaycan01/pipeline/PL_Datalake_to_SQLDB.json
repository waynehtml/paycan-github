{
	"name": "PL_Datalake_to_SQLDB",
	"properties": {
		"activities": [
			{
				"name": "Lookup FileNames",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_Config_JSON_file",
						"type": "DatasetReference",
						"parameters": {
							"container": {
								"value": "@pipeline().parameters.prm_config_container",
								"type": "Expression"
							},
							"directory": {
								"value": "@pipeline().parameters.prm_config_directory",
								"type": "Expression"
							},
							"filename": {
								"value": "@pipeline().parameters.prm_config_file_tables_publish",
								"type": "Expression"
							}
						}
					}
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup FileNames",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@array(activity('Lookup FileNames').output.firstRow.filenames)",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Upload Data to SQL",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "ParquetSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": false,
										"wildcardFolderPath": {
											"value": "@concat(pipeline().parameters.prm_curated_directory,'/',item().name,'/')",
											"type": "Expression"
										},
										"wildcardFileName": "*.parquet",
										"enablePartitionDiscovery": false
									}
								},
								"sink": {
									"type": "AzureSqlSink",
									"preCopyScript": {
										"value": "@{concat('TRUNCATE TABLE [paycan_restricted_curated].LYNX_',toUpper(item().name))}",
										"type": "Expression"
									},
									"writeBehavior": "insert",
									"disableMetricsCollection": false
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_Curated_Parquet_File",
									"type": "DatasetReference",
									"parameters": {
										"Container": {
											"value": "@pipeline().parameters.prm_curated_container",
											"type": "Expression"
										},
										"FolderPath": {
											"value": "@pipeline().parameters.prm_curated_directory",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_SQL_Curated_Tables",
									"type": "DatasetReference",
									"parameters": {
										"TableName": {
											"value": "@concat('LYNX_',toUpper(item().name))",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "Stored procedure1",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "ForEach1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": {
						"value": "sp_executesql",
						"type": "Expression"
					},
					"storedProcedureParameters": {
						"statement": {
							"value": "exec sp_updatestats;"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_SQL_Database",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Wait1",
				"type": "Wait",
				"dependsOn": [
					{
						"activity": "Stored procedure1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"waitTimeInSeconds": 1
				}
			}
		],
		"concurrency": 1,
		"parameters": {
			"prm_curated_container": {
				"type": "string",
				"defaultValue": "restricted"
			},
			"prm_curated_directory": {
				"type": "string",
				"defaultValue": "curated/paycan/lynx"
			},
			"prm_config_container": {
				"type": "string",
				"defaultValue": "config-paycan"
			},
			"prm_config_directory": {
				"type": "string",
				"defaultValue": "lynx"
			},
			"prm_config_file_tables_publish": {
				"type": "string",
				"defaultValue": "tables_publish.json"
			}
		},
		"folder": {
			"name": "Lynx/Dynamic"
		},
		"annotations": [],
		"lastPublishTime": "2021-04-26T20:29:02Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}