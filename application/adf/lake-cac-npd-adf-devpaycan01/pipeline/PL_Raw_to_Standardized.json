{
	"name": "PL_Raw_to_Standardized",
	"properties": {
		"activities": [
			{
				"name": "File Validation",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Lookup Holidays Config",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": {
						"value": "@pipeline().parameters.prm_notebook_file_validation",
						"type": "Expression"
					},
					"baseParameters": {
						"config_container": {
							"value": "@pipeline().parameters.prm_config_container",
							"type": "Expression"
						},
						"config_path": {
							"value": "@pipeline().parameters.prm_config_path",
							"type": "Expression"
						},
						"file_container": {
							"value": "@pipeline().parameters.prm_restricted_container",
							"type": "Expression"
						},
						"holiday_config": {
							"value": "@string(activity('Lookup Holidays Config').output.firstRow)",
							"type": "Expression"
						},
						"storage_name_config": {
							"value": "@pipeline().parameters.prm_config_storage",
							"type": "Expression"
						},
						"storage_name_restricted": {
							"value": "@pipeline().parameters.prm_storage",
							"type": "Expression"
						},
						"cycle_date": {
							"value": "@pipeline().parameters.prm_date",
							"type": "Expression"
						},
						"file_path": {
							"value": "@pipeline().parameters.prm_directory_raw",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "Databricks_LS_UC",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Lookup Holidays Config",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_Config_JSON_file",
						"type": "DatasetReference",
						"parameters": {
							"container": {
								"value": "@pipeline().parameters.prm_config_container",
								"type": "Expression"
							},
							"directory": {
								"value": "@pipeline().parameters.prm_config_path",
								"type": "Expression"
							},
							"filename": {
								"value": "@pipeline().parameters.prm_config_file_holidays",
								"type": "Expression"
							}
						}
					}
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup Config",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Lookup FileNames",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@array(activity('Lookup FileNames').output.firstRow.filenames)",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 5,
					"activities": [
						{
							"name": "Validate and Move to Standardized",
							"type": "DatabricksNotebook",
							"dependsOn": [],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"notebookPath": {
									"value": "@pipeline().parameters.prm_notebook_validate_move_to_standardized",
									"type": "Expression"
								},
								"baseParameters": {
									"cycle_date": {
										"value": "@pipeline().parameters.prm_date",
										"type": "Expression"
									},
									"file": {
										"value": "@concat(string(item().name),'_',pipeline().parameters.prm_date,'.csv')",
										"type": "Expression"
									},
									"config": {
										"value": "@string(activity('Lookup Config').output.firstRow)",
										"type": "Expression"
									},
									"container_name": {
										"value": "@pipeline().parameters.prm_restricted_container",
										"type": "Expression"
									},
									"storage_name": {
										"value": "@pipeline().parameters.prm_storage",
										"type": "Expression"
									},
									"raw_path": {
										"value": "@pipeline().parameters.prm_directory_raw",
										"type": "Expression"
									},
									"stan_path": {
										"value": "@pipeline().parameters.prm_directory_std",
										"type": "Expression"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "Databricks_LS_UC",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			},
			{
				"name": "Lookup Config",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "File Validation",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_Config_JSON_file",
						"type": "DatasetReference",
						"parameters": {
							"container": {
								"value": "@pipeline().parameters.prm_config_container",
								"type": "Expression"
							},
							"directory": {
								"value": "@pipeline().parameters.prm_config_path",
								"type": "Expression"
							},
							"filename": {
								"value": "@pipeline().parameters.prm_config_file_standard",
								"type": "Expression"
							}
						}
					}
				}
			},
			{
				"name": "Lookup FileNames",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "File Validation",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_Config_JSON_file",
						"type": "DatasetReference",
						"parameters": {
							"container": {
								"value": "@pipeline().parameters.prm_config_container",
								"type": "Expression"
							},
							"directory": {
								"value": "@pipeline().parameters.prm_config_path",
								"type": "Expression"
							},
							"filename": {
								"value": "@pipeline().parameters.prm_config_file_ingestion",
								"type": "Expression"
							}
						}
					}
				}
			}
		],
		"concurrency": 1,
		"parameters": {
			"prm_date": {
				"type": "string"
			},
			"prm_restricted_container": {
				"type": "string",
				"defaultValue": "restricted"
			},
			"prm_directory_raw": {
				"type": "string",
				"defaultValue": "raw/external/payments_canada/lynx"
			},
			"prm_config_file_standard": {
				"type": "string",
				"defaultValue": "files_standard.json"
			},
			"prm_storage": {
				"type": "string",
				"defaultValue": "lakecacnpdstdev01"
			},
			"prm_config_container": {
				"type": "string",
				"defaultValue": "config-paycan"
			},
			"prm_config_storage": {
				"type": "string",
				"defaultValue": "lakecanpdstdevland01"
			},
			"prm_config_path": {
				"type": "string",
				"defaultValue": "lynx"
			},
			"prm_config_file_holidays": {
				"type": "string",
				"defaultValue": "holidays.json"
			},
			"prm_directory_std": {
				"type": "string",
				"defaultValue": "standardized/external/payments_canada/lynx"
			},
			"prm_config_file_ingestion": {
				"type": "string",
				"defaultValue": "files_ingestion.json"
			},
			"prm_notebook_file_validation": {
				"type": "string",
				"defaultValue": "/paycan/lynx/20_standardized/std_file_validation"
			},
			"prm_notebook_validate_move_to_standardized": {
				"type": "string",
				"defaultValue": "/paycan/lynx/20_standardized/1_std_main"
			}
		},
		"folder": {
			"name": "Lynx/Dynamic"
		},
		"annotations": [],
		"lastPublishTime": "2021-04-26T20:28:13Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}