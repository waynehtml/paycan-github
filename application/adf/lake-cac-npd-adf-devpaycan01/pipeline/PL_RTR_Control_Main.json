			{
				"name": "Set Date",
				"description": "if not set, date is set to yesterdays date",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "var_date",
					"value": {
						"value": "@if(\n  or(\n    equals(pipeline().parameters.prm_date, null),\n    equals(pipeline().parameters.prm_date, 'yyyy-MM-dd')\n  ),\n  formatDateTime(addDays(utcnow(), -1), 'yyyy-MM-dd'),\n  formatDateTime(pipeline().parameters.prm_date, 'yyyy-MM-dd')\n)",
						"type": "Expression"
					}
				}
			}
