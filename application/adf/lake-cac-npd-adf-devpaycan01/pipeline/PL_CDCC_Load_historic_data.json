						{
							"name": "Raw to Standardized",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_CDCC_Raw_to_Standardized_hostoric_data",
									"type": "PipelineReference"
