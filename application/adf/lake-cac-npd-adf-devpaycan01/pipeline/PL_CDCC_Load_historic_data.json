								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_CDCC_Land_to_Raw_historic_data",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
