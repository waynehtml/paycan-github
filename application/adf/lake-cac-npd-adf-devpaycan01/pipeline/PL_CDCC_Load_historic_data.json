										"value": "@pipeline().parameters.prm_land_container",
										"type": "Expression"
									},
									"prm_land_directory": {
										"value": "@pipeline().parameters.prm_land_directory",
										"type": "Expression"
									},
									"prm_raw_container": {
										"value": "@pipeline().parameters.prm_raw_container",
										"type": "Expression"
									},
									"prm_raw_directory": {
										"value": "@pipeline().parameters.prm_raw_directory",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			},
			{
				"name": "Whether raw to UC",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Whether land to raw",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(pipeline().parameters.raw_to_uc, '1')",
						"type": "Expression"
					},
