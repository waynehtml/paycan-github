										"value": "@pipeline().parameters.prm_raw_container",
										"type": "Expression"
									},
									"prm_raw_directory": {
										"value": "@pipeline().parameters.prm_raw_directory",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			}
