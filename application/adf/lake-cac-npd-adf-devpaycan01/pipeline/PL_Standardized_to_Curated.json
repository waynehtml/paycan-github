{
	"name": "PL_Standardized_to_Curated",
	"properties": {
		"activities": [
			{
				"name": "ForEach1",
				"description": "The reason why the for-each loop is sequential is that the notebooks are writing to the same validation file.",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup FileNames",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@array(activity('Lookup FileNames').output.firstRow.filenames)",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Validate and move to Curated",
							"type": "DatabricksNotebook",
							"dependsOn": [],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"notebookPath": {
									"value": "@pipeline().parameters.prm_notebook_validate_and_move_to_curated",
									"type": "Expression"
								},
								"baseParameters": {
									"cycle_date": {
										"value": "@replace(pipeline().parameters.prm_date,'-','')",
										"type": "Expression"
									},
									"file": {
										"value": "@item().name",
										"type": "Expression"
									},
									"storage": {
										"value": "@pipeline().parameters.prm_storage",
										"type": "Expression"
									},
									"container": {
										"value": "@pipeline().parameters.prm_container",
										"type": "Expression"
									},
									"std_dir": {
										"value": "@pipeline().parameters.prm_std_directory",
										"type": "Expression"
									},
									"cur_dir": {
										"value": "@pipeline().parameters.prm_cur_directory",
										"type": "Expression"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "Databricks_LS_UC",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			},
			{
				"name": "credit_activity_summary",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "ForEach1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": {
						"value": "@pipeline().parameters.prm_notebook_credit_activity_summary",
						"type": "Expression"
					},
					"baseParameters": {
						"container_name": {
							"value": "@pipeline().parameters.prm_container",
							"type": "Expression"
						},
						"storage_name": {
							"value": "@pipeline().parameters.prm_storage",
							"type": "Expression"
						},
						"cur_path": {
							"value": "@pipeline().parameters.prm_cur_directory",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "Databricks_LS_UC",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "payment_summary",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "ForEach1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": {
						"value": "@pipeline().parameters.prm_notebook_payment_summary",
						"type": "Expression"
					},
					"baseParameters": {
						"container_name": {
							"value": "@pipeline().parameters.prm_container",
							"type": "Expression"
						},
						"storage_name": {
							"value": "@pipeline().parameters.prm_storage",
							"type": "Expression"
						},
						"cur_path": {
							"value": "@pipeline().parameters.prm_cur_directory",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "Databricks_LS_UC",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "transfer_summary",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "ForEach1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": {
						"value": "@pipeline().parameters.prm_notebook_transfer_summary",
						"type": "Expression"
					},
					"baseParameters": {
						"container_name": {
							"value": "@pipeline().parameters.prm_container",
							"type": "Expression"
						},
						"storage_name": {
							"value": "@pipeline().parameters.prm_storage",
							"type": "Expression"
						},
						"cur_path": {
							"value": "@pipeline().parameters.prm_cur_directory",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "Databricks_LS_UC",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Lookup FileNames",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_Config_JSON_file",
						"type": "DatasetReference",
						"parameters": {
							"container": {
								"value": "@pipeline().parameters.prm_config_container",
								"type": "Expression"
							},
							"directory": {
								"value": "@pipeline().parameters.prm_config_path",
								"type": "Expression"
							},
							"filename": {
								"value": "@pipeline().parameters.prm_config_file_ingestion",
								"type": "Expression"
							}
						}
					}
				}
			}
		],
		"concurrency": 1,
		"parameters": {
			"prm_date": {
				"type": "string"
			},
			"prm_container": {
				"type": "string",
				"defaultValue": "restricted"
			},
			"prm_storage": {
				"type": "string",
				"defaultValue": "lakecacnpdstdev01"
			},
			"prm_std_directory": {
				"type": "string",
				"defaultValue": "standardized/external/payments_canada/lynx"
			},
			"prm_cur_directory": {
				"type": "string",
				"defaultValue": "curated/paycan/lynx"
			},
			"prm_config_file_ingestion": {
				"type": "string",
				"defaultValue": "files_ingestion.json"
			},
			"prm_config_container": {
				"type": "string",
				"defaultValue": "config-paycan"
			},
			"prm_config_path": {
				"type": "string",
				"defaultValue": "lynx"
			},
			"prm_notebook_validate_and_move_to_curated": {
				"type": "string",
				"defaultValue": "/paycan/lynx/30_curated/1_curate_main"
			},
			"prm_notebook_credit_activity_summary": {
				"type": "string",
				"defaultValue": "/paycan/lynx/30_curated/credit_activity_summary"
			},
			"prm_notebook_payment_summary": {
				"type": "string",
				"defaultValue": "/paycan/lynx/30_curated/payment_summary"
			},
			"prm_notebook_transfer_summary": {
				"type": "string",
				"defaultValue": "/paycan/lynx/30_curated/transfer_summary"
			}
		},
		"folder": {
			"name": "Lynx/Dynamic"
		},
		"annotations": [],
		"lastPublishTime": "2021-04-26T20:29:59Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}