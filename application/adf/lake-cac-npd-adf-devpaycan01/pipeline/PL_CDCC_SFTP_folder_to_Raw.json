{
	"name": "PL_CDCC_SFTP_folder_to_Raw",
	"properties": {
		"activities": [
			{
				"name": "Load Config File",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_Config_JSON_file",
						"type": "DatasetReference",
						"parameters": {
							"container": {
								"value": "@pipeline().globalParameters.gpm_container_config",
								"type": "Expression"
							},
							"directory": {
								"value": "@pipeline().globalParameters.gpm_cdcc_folder",
								"type": "Expression"
							},
							"filename": {
								"value": "@string('files_ingestion.json')",
								"type": "Expression"
							}
						}
					}
				}
			},
			{
				"name": "SFTP to AV",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Load Config File",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "SftpReadSettings",
							"maxConcurrentConnections": 1,
							"recursive": true,
							"wildcardFolderPath": {
								"value": "@pipeline().parameters.sftp_folder",
								"type": "Expression"
							},
							"wildcardFileName": "*",
							"deleteFilesAfterCompletion": false,
							"disableChunking": false
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureBlobStorageWriteSettings",
							"copyBehavior": "PreserveHierarchy"
						}
					},
					"enableStaging": false,
					"parallelCopies": 1
				},
				"inputs": [
					{
						"referenceName": "DS_SFTP",
						"type": "DatasetReference",
						"parameters": {
							"host": "@activity('Load Config File').output.firstRow.sftp.ingestion_info[0].host",
							"user_name": "@activity('Load Config File').output.firstRow.sftp.ingestion_info[0].authentication.username",
							"secret_key_vault": "@activity('Load Config File').output.firstRow.sftp.ingestion_info[0].authentication.username",
							"sftp_folder": "@pipeline().parameters.sftp_folder",
							"file_name": "@null",
							"port": "@activity('Load Config File').output.firstRow.sftp.ingestion_info[0].port"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_AV_Scan",
						"type": "DatasetReference",
						"parameters": {
							"container": "@activity('Load Config File').output.firstRow.av_scan_container",
							"directory": {
								"value": "@concat(activity('Load Config File').output.firstRow.av_scan_folder, '/sftp/', last(split(pipeline().parameters.sftp_folder, '/')))",
								"type": "Expression"
							},
							"file_name": "@null"
						}
					}
				]
			},
			{
				"name": "Wait for AvScan",
				"type": "Wait",
				"dependsOn": [
					{
						"activity": "SFTP to AV",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"waitTimeInSeconds": 60
				}
			},
			{
				"name": "Landing to Raw",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Wait for AvScan",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"maxConcurrentConnections": 1,
							"recursive": true,
							"deleteFilesAfterCompletion": false
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings",
							"copyBehavior": "PreserveHierarchy"
						}
					},
					"enableStaging": false,
					"parallelCopies": 1
				},
				"inputs": [
					{
						"referenceName": "DS_FS_Land_Scan",
						"type": "DatasetReference",
						"parameters": {
							"container": {
								"value": "@activity('Load Config File').output.firstRow.land_scan_container",
								"type": "Expression"
							},
							"directory": {
								"value": "@concat(activity('Load Config File').output.firstRow.land_scan_folder, '/sftp/', last(split(pipeline().parameters.sftp_folder, '/')))",
								"type": "Expression"
							},
							"filename": "@null"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_Raw_Binary_File",
						"type": "DatasetReference",
						"parameters": {
							"container": {
								"value": "@activity('Load Config File').output.firstRow.data_container",
								"type": "Expression"
							},
							"directory": {
								"value": "@concat(replace(activity('Load Config File').output.firstRow.raw_folder,\n            'CDCCStatistics{YYYYMMDD}',\n            'sftp'\n        ),\n    '/',\n    last(split(pipeline().parameters.sftp_folder, '/'))\n)",
								"type": "Expression"
							},
							"filename": "@null"
						}
					}
				]
			},
			{
				"name": "Delete from Landing",
				"type": "Delete",
				"dependsOn": [
					{
						"activity": "Landing to Raw",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_FS_Land_Scan",
						"type": "DatasetReference",
						"parameters": {
							"container": "@activity('Load Config File').output.firstRow.land_scan_container",
							"directory": {
								"value": "@concat(activity('Load Config File').output.firstRow.land_scan_folder, '/sftp/', last(split(pipeline().parameters.sftp_folder, '/')))",
								"type": "Expression"
							},
							"filename": "@null"
						}
					},
					"enableLogging": false,
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					}
				}
			}
		],
		"parameters": {
			"sftp_folder": {
				"type": "string"
			}
		},
		"folder": {
			"name": "CDCC/Control"
		},
		"annotations": []
	}
}