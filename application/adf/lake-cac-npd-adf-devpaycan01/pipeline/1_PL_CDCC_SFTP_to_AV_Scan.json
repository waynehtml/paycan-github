{
	"name": "1_PL_CDCC_SFTP_to_AV_Scan",
	"properties": {
		"activities": [
			{
				"name": "Load Config File",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_Config_JSON_file",
						"type": "DatasetReference",
						"parameters": {
							"container": {
								"value": "@pipeline().globalParameters.gpm_container_config",
								"type": "Expression"
							},
							"directory": {
								"value": "@pipeline().globalParameters.gpm_cdcc_folder",
								"type": "Expression"
							},
							"filename": {
								"value": "@string('files_ingestion.json')",
								"type": "Expression"
							}
						}
					}
				}
			},
			{
				"name": "Get SFTP File List",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "Load Config File",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_SFTP",
						"type": "DatasetReference",
						"parameters": {
							"host": "@activity('Load Config File').output.firstRow.sftp.ingestion_info[0].host",
							"user_name": "@activity('Load Config File').output.firstRow.sftp.ingestion_info[0].authentication.username",
							"secret_key_vault": "@activity('Load Config File').output.firstRow.sftp.ingestion_info[0].authentication.keyVault_key_file",
							"sftp_folder": {
								"value": "@replace(activity('Load Config File').output.firstRow.sftp.ingestion_info[0].get, '{delta_year}', formatDateTime(addDays(pipeline().parameters.pm_date, sub(-5, dayOfWeek(pipeline().parameters.pm_date))), 'yyyy'))\n",
								"type": "Expression"
							},
							"file_name": "@null",
							"port": "@activity('Load Config File').output.firstRow.sftp.ingestion_info[0].port"
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "SftpReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false,
						"disableChunking": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "Get this week file",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "Get SFTP File List",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get SFTP File List').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@and(\nequals(item().type, 'File'), \nand(\ngreaterOrEquals(div(sub(\n    ticks(pipeline().parameters.pm_date),\n    ticks(concat(substring(item().name, sub(length(item().name),12), 4),'-',substring(item().name, sub(length(item().name),8), 2),'-',substring(item().name, sub(length(item().name),6), 2)))\n  ),  864000000000), 0),\nless(div(sub(\n    ticks(pipeline().parameters.pm_date),\n    ticks(concat(substring(item().name, sub(length(item().name),12), 4),'-',substring(item().name, sub(length(item().name),8), 2),'-',substring(item().name, sub(length(item().name),6), 2)))\n  ),  864000000000), 7)))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "If this week file is ready",
				"type": "Switch",
				"dependsOn": [
					{
						"activity": "Get this week file",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@string(length(activity('Get this week file').output.value))",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "0",
							"activities": [
								{
									"name": "SFTP file not ready",
									"type": "Fail",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"message": "The requested file isn’t ready on the TMX SFTP site.",
										"errorCode": "2000"
									}
								}
							]
						},
						{
							"value": "1",
							"activities": [
								{
									"name": "SFTP to AV Scan",
									"description": " ",
									"type": "Copy",
									"dependsOn": [
										{
											"activity": "Set file_date",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "BinarySource",
											"storeSettings": {
												"type": "SftpReadSettings",
												"recursive": true,
												"deleteFilesAfterCompletion": false,
												"disableChunking": false
											},
											"formatSettings": {
												"type": "BinaryReadSettings"
											}
										},
										"sink": {
											"type": "BinarySink",
											"storeSettings": {
												"type": "AzureBlobStorageWriteSettings",
												"copyBehavior": "PreserveHierarchy"
											}
										},
										"enableStaging": false
									},
									"inputs": [
										{
											"referenceName": "DS_SFTP",
											"type": "DatasetReference",
											"parameters": {
												"host": {
													"value": "@activity('Load Config File').output.firstRow.sftp.ingestion_info[0].host",
													"type": "Expression"
												},
												"user_name": {
													"value": "@activity('Load Config File').output.firstRow.sftp.ingestion_info[0].authentication.username",
													"type": "Expression"
												},
												"secret_key_vault": {
													"value": "@activity('Load Config File').output.firstRow.sftp.ingestion_info[0].authentication.keyVault_key_file",
													"type": "Expression"
												},
												"sftp_folder": {
													"value": "@replace(activity('Load Config File').output.firstRow.sftp.ingestion_info[0].get, '{delta_year}', formatDateTime(adddays(pipeline().parameters.pm_date, -7), 'yyyy'))\n\n\n\n\n\n",
													"type": "Expression"
												},
												"file_name": {
													"value": "@activity('Get this week file').output.value[0].name",
													"type": "Expression"
												},
												"port": {
													"value": "@activity('Load Config File').output.firstRow.sftp.ingestion_info[0].port",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "DS_AV_Scan",
											"type": "DatasetReference",
											"parameters": {
												"container": {
													"value": "@activity('Load Config File').output.firstRow.av_scan_container",
													"type": "Expression"
												},
												"directory": {
													"value": "@activity('Load Config File').output.firstRow.av_scan_folder_compressed",
													"type": "Expression"
												},
												"file_name": {
													"value": "@null",
													"type": "Expression"
												}
											}
										}
									]
								},
								{
									"name": "Wait for Scan",
									"description": "Wait time to make sure the file will be in Land Scan before start top copy",
									"type": "Wait",
									"dependsOn": [
										{
											"activity": "SFTP to AV Scan",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"waitTimeInSeconds": 60
									}
								},
								{
									"name": "Set file_date",
									"type": "SetVariable",
									"dependsOn": [],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "pipelineReturnValue",
										"value": [
											{
												"key": "file_date",
												"value": {
													"type": "Expression",
													"content": "@substring(activity('Get this week file').output.value[0].name, sub(length(activity('Get this week file').output.value[0].name),12), 8)\n"
												}
											}
										],
										"setSystemVariable": true
									}
								}
							]
						}
					],
					"defaultActivities": [
						{
							"name": "Too many SFTP file",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "There are more than 1 zip file for this week, Contact TMX.",
								"errorCode": "1000"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"pm_date": {
				"type": "string",
				"defaultValue": "2025-07-24"
			}
		},
		"variables": {
			"prevMonday": {
				"type": "String"
			},
			"prevTuesday": {
				"type": "String"
			}
		},
		"folder": {
			"name": "CDCC/Dynamics"
		},
		"annotations": []
	}
}